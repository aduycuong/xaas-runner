{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xaas-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Runs next to the database (PlanetScale, aws ap-southeast-1): each step does several queries.
  // Smart Placement left it where QStash calls from (IAD), ~600 ms per query (2026-11-14).
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },
  "observability": { "enabled": true },
  // Warm connections to PlanetScale (cache off); used instead of DATABASE_URL. See the README of the workers folder.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "c524d196b04e409ea2ad8d9888cde6f9" }],
  // One binding per deployed node version. The binding name is the Worker name in upper case
  // with every other character turned into "_" (bindingName in src/logic.ts).
  // To add a node: deploy the node Worker first, add its binding here, then deploy the runner.
  "services": [
    { "binding": "NODE_CORE_DELAY_V1_0_0", "service": "node-core-delay-v1-0-0" },
    { "binding": "NODE_CORE_POLL_DELAY_V1_0_0", "service": "node-core-poll-delay-v1-0-0" },
    { "binding": "NODE_HTTP_REQUEST_V1_0_0", "service": "node-http-request-v1-0-0" },
    { "binding": "NODE_DATA_TRANSFORM_V1_0_0", "service": "node-data-transform-v1-0-0" },
    { "binding": "NODE_FB_PAGE_POST_V1_0_0", "service": "node-fb-page-post-v1-0-0" },
    { "binding": "NODE_GSHEET_APPEND_V1_0_0", "service": "node-gsheet-append-v1-0-0" },
    { "binding": "NODE_TELEGRAM_SEND_V1_0_0", "service": "node-telegram-send-v1-0-0" },
    { "binding": "NODE_GDRIVE_READ_FILE_V1_0_0", "service": "node-gdrive-read-file-v1-0-0" },
    { "binding": "NODE_NOTIFY_EMAIL_V2_0_0", "service": "node-notify-email-v2-0-0" },
    { "binding": "NODE_CORE_ECHO_V1_5_0", "service": "node-core-echo-v1-5-0" },
    { "binding": "NODE_HUMAN_ASK_V4_0_0", "service": "node-human-ask-v4-0-0" },
    { "binding": "NODE_FB_COMMENT_REPLY_V1_0_1", "service": "node-fb-comment-reply-v1-0-1" },
    { "binding": "NODE_FB_MESSENGER_SEND_V1_0_1", "service": "node-fb-messenger-send-v1-0-1" },
    { "binding": "NODE_FB_LEAD_GET_V1_0_1", "service": "node-fb-lead-get-v1-0-1" },
    { "binding": "NODE_IMAGE_OPENAI_V1_1_0", "service": "node-image-openai-v1-1-0" },
    { "binding": "NODE_IMAGE_FAL_V1_2_0", "service": "node-image-fal-v1-2-0" },
    { "binding": "NODE_IMAGE_REPLICATE_V1_1_0", "service": "node-image-replicate-v1-1-0" },
    { "binding": "NODE_IMAGE_COMPOSE_V1_1_0", "service": "node-image-compose-v1-1-0" },
    { "binding": "NODE_IMAGE_TRANSFORM_V1_1_0", "service": "node-image-transform-v1-1-0" },
    { "binding": "NODE_IMAGE_GEMINI_V1_1_1", "service": "node-image-gemini-v1-1-1" },
    { "binding": "NODE_AI_LLM_V2_3_1", "service": "node-ai-llm-v2-3-1" },
    { "binding": "NODE_FILES_UPLOAD_LINK_V1_0_0", "service": "node-files-upload-link-v1-0-0" }
  ],
  "vars": {
    "QSTASH_URL": "https://qstash-eu-central-1.upstash.io",
    "INGRESS_URL": "https://ingress.xaas.im"
  }
  // Secrets (wrangler secret put, or .dev.vars locally):
  //   DATABASE_URL, QSTASH_TOKEN, QSTASH_CURRENT_SIGNING_KEY, QSTASH_NEXT_SIGNING_KEY, RUNNER_ADMIN_TOKEN,
  //   CALLBACK_SIGNING_KEY (same as the ingress), RESOURCE_TOKEN_SECRET (async nodes)
  // DATABASE_URL: PlanetScale Postgres, `?sslmode=verify-full` without `sslrootcert` (pg reads that as a file path).
  // Optional: a Hyperdrive binding named HYPERDRIVE replaces DATABASE_URL (see the README of the workers folder).
  // Optional, for realtime updates to the UI (same values as the app): FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY, FIREBASE_DATABASE_URL
}
