# Copy to .dev.vars (not committed). Used by wrangler dev.
DATABASE_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only when your QStash is not on the default endpoint (regional, or the local dev server).
# QSTASH_URL=
# Local only: the public URL of the tunnel that points at wrangler dev, so Upstash calls it back there.
# UPSTASH_WORKFLOW_URL=https://dev.example.com
# Bearer token of GET /nodes/<worker name>/health; the deploy script sends it (RUNNER_ADMIN_TOKEN in the app).
RUNNER_ADMIN_TOKEN=
